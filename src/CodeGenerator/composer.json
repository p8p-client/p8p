{
    "name": "p8p/generator",
    "description": "Code generator that creates strongly-typed PHP classes from Kubernetes OpenAPI specifications",
    "license": "MIT",
    "authors": [
        {
            "name": "Julien Jacottet",
            "email": "jjacottet@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "p8p/client": "self.version",
        "cebe/php-openapi": "^1.8.0",
        "symfony/console": "^7.3",
        "symfony/type-info": "^7.3",
        "nette/php-generator": "^v4.2",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.4.0",
        "symfony/var-dumper": "^7.3"
    },
    "autoload": {
        "psr-4": {
            "P8p\\CodeGenerator\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "P8p\\CodeGenerator\\Tests\\": "tests"
        }
    }
}
